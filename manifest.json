{
  "manifest_version": 3,
  "name": "__MSG_app_name__",
  "version": "1.4.0",
  "description": "__MSG_app_description__",
  "default_locale": "en",
  "homepage_url": "https://github.com/thinko/lost-in-transcription",
  "permissions": [
    "storage",
    "activeTab",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "*://*.dod.teams.microsoft.us/*",
    "*://*.gov.teams.microsoft.us/*",
    "*://*.lync.com/*",
    "*://*.online.dod.skypeforbusiness.us/*",
    "*://*.partner.lync.cn/*",
    "*://*.skype.com/*",
    "*://*.teams.cloud.microsoft/*",
    "*://*.teams.microsoft.com/*",
    "*://*.teams.microsoftonline.cn/*",
    "*://dod.teams.microsoft.us/*",
    "*://gov.teams.microsoft.us/*",
    "*://teams.cloud.microsoft/*",
    "*://teams.microsoft.com/*",
    "*://teams.microsoftonline.cn/*",
    "*://api.cognitive.microsofttranslator.com/*",
    "*://translation.googleapis.com/*",
    "*://api-free.deepl.com/*",
    "*://api.deepl.com/*",
    "*://api.openai.com/*",
    "*://libretranslate.com/*",
    "*://libretranslate.de/*",
    "http://localhost/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.dod.teams.microsoft.us/*",
        "*://*.gov.teams.microsoft.us/*",
        "*://*.lync.com/*",
        "*://*.online.dod.skypeforbusiness.us/*",
        "*://*.partner.lync.cn/*",
        "*://*.skype.com/*",
        "*://*.teams.cloud.microsoft/*",
        "*://*.teams.microsoft.com/*",
        "*://*.teams.microsoftonline.cn/*",
        "*://dod.teams.microsoft.us/*",
        "*://gov.teams.microsoft.us/*",
        "*://teams.cloud.microsoft/*",
        "*://teams.microsoft.com/*",
        "*://teams.microsoftonline.cn/*"
      ],
      "js": ["content.js", "sidepanel.js", "export.js", "glossary-popover.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-display-mode": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "__MSG_cmd_toggle_display__"
    },
    "export-transcript": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "__MSG_cmd_export__"
    }
  }
}
